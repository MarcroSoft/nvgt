/* sharpvox_voice_test.nvgt - audition NVGT's builtin SharpVox fallback TTS voice.
 *
 * The fallback voice (engine name "fallback") is what NVGT speaks with when no OS
 * speech engine is available. This little command line tool lets you hear it at
 * different pitch/rate/volume settings so you can pick values that sound right.
 *
 * Arguments go after a "--" separator:
 *
 *   nvgt other/sharpvox_voice_test.nvgt
 *       Pitch sweep: speaks a sample phrase at pitch -10, -5, 0, 5 and 10 so you
 *       can compare tones. (pitch 0 is the current default.)
 *
 *   nvgt other/sharpvox_voice_test.nvgt -- "hello there"
 *       Speak custom text at the default settings.
 *
 *   nvgt other/sharpvox_voice_test.nvgt -- pitch=6 rate=2 volume=-6 "hello there"
 *       Speak with explicit settings. pitch and rate are -10..10 (0 = default,
 *       higher pitch = brighter, higher rate = faster). volume is -100..0 dB.
 *
 *   nvgt other/sharpvox_voice_test.nvgt -- pitch=6 save=out.wav "hello"
 *       Also write the result to out.wav (useful on machines with no audio out).
 */

string append_word(string text, string word) {
	return text == ""? word : text + " " + word;
}

void main() {
	float pitch = 0, rate = 0, volume = 0;
	bool has_settings = false;
	string text = "";
	string save = "";

	for (uint i = 0; i < ARGS.length(); i++) {
		string a = ARGS[i];
		if (a.ends_with(".nvgt")) continue; // the script path itself
		string[]@ kv = a.split("=");
		if (kv.length() >= 2) {
			string key = kv[0], val = kv[1];
			if (key == "pitch") { pitch = parse_float(val); has_settings = true; }
			else if (key == "rate") { rate = parse_float(val); has_settings = true; }
			else if (key == "volume") { volume = parse_float(val); has_settings = true; }
			else if (key == "save") save = val;
			else if (key == "text") text = append_word(text, val);
			else text = append_word(text, a); // unknown key=..., treat as text
		} else text = append_word(text, a);
	}

	tts_voice v("fallback");
	string phrase = "The quick brown fox jumps over the lazy dog.";

	// No text and no explicit settings: run the comparison sweep.
	if (text == "" && !has_settings && save == "") {
		float[] steps = {-10, -5, 0, 5, 10};
		for (uint i = 0; i < steps.length(); i++) {
			v.set_pitch(steps[i]);
			v.speak_wait("Pitch " + format_float(steps[i], precision: 0) + ". " + phrase);
			wait(400);
		}
		return;
	}

	if (text == "") text = phrase;
	v.set_pitch(pitch);
	v.set_rate(rate);
	v.set_volume(volume);
	if (save != "") v.speak_to_file(save, text);
	v.speak_wait(text);
}
