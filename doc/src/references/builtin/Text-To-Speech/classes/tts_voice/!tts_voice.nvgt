/**
	This class provides a convenient way to communicate with all of the text-to-speech voices a user has installed on their system.
	tts_voice();
	## Remarks:
		NVGT implements a [builtin fallback speech synthesizer](https://github.com/akse0435/SharpVoxTTS) called SharpVox that is used either when there is no speech engine available on the system, or if it is explicitly set with the tts_voice::set_voice() function. It is a compact formant synthesizer intended as a last resort, because after all understandable speech is better than no speech at all. It is also useful when porting NVGT to other platforms, because it allows focus to be primarily fixed on getting nvgt to run while individual tts engine support on each platform could be added later. If you don't want your end users to be able to select this speech synthesizer, pass a blank string to this constructor.
*/

// Example:
void main() {
	tts_voice v;
	v.speak_wait("Type some text and I'll repeat it. Leave the field blank to stop");
	string text = "";
	while (true) {
		text = input_box("Text", "Type some text to have the TTS speak.");
		if (text.empty()) break;
		v.speak(text);
	}
}
