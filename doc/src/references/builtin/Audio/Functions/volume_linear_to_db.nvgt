/**
	Convert a linear amplitude to the db value that the default audio engine expects for volume.
	float volume_linear_to_db(float linear);
	## Arguments:
		float linear: a linear amplitude, where 1.0 is full volume, 0.5 is half amplitude and 0.0 is silence.
	## Returns:
		float: the equivalent volume in db (0 is full, negative values are quieter).
	## Remarks:
		The default engine expresses volume in db, where even -50 is practically inaudible. If you would rather work with a linear amplitude, set the volume property from this function. volume_db_to_linear performs the inverse conversion.
*/

// Example:
void main() {
	sound s;
	s.load("music.ogg");
	s.volume = volume_linear_to_db(0.5); // Half amplitude.
	s.play_wait();
}
