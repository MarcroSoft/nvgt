Import("env")
#env.Append(CPPDEFINES = ["WDL_ALLOW_UNSIGNED_DEFAULT_CHAR"])

sources = ["cmp.c", "entities.cpp", "ma_reverb_node.c", "micropather.cpp", "miniaudio_libopus.c", "miniaudio_libvorbis.c", "miniaudio_phonon.c", "miniaudio_wdl_resampler.cpp", "monocypher.c", "resample.cpp", "rng_get_bytes.c", "singleheader.cpp", "sonic.c", "uncompr.c", "tonar.c"]
if env["NVGT_TARGET"] == "windows":
	sources += ["InputBox.cpp", "sapibridge.c", "vs_version.cpp", "windows_process_watcher.cpp"]
# SharpVox TTS provides the builtin fallback speech synthesizer (see src/tts.cpp). It is a
# multi-file C++ library vendored under sharpvox/; its sources use include-relative paths, so
# its own include/ directory must be on the search path when compiling them. Compile them into
# their own objects (with SharpVox-specific include paths and compatibility defines) and add the
# resulting objects to the shared deps library.
sharpvox_cpppath = list(env["CPPPATH"]) + ["#dep/sharpvox/include", "#dep/sharpvox/platform/lib"]
sharpvox_defines = list(env["CPPDEFINES"]) + ["_LIB"]
if env["NVGT_TARGET"] == "windows":
	# MSVC does not provide the POSIX case-insensitive compare names SharpVox uses; map them to the CRT equivalents.
	sharpvox_defines += [("strncasecmp", "_strnicmp"), ("strcasecmp", "_stricmp")]
sharpvox_objects = env.Object(Glob("sharpvox/src/*.cpp") + ["sharpvox/platform/lib/SharpVox.cpp"], CPPPATH = sharpvox_cpppath, CPPDEFINES = sharpvox_defines)
env.StaticLibrary("#build/lib/deps", sources + sharpvox_objects, CPPDEFINES = list(env["CPPDEFINES"]) + ["_LIB"])
